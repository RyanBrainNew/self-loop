{
  "name": "self-loop",
  "version": "0.8.0",
  "private": true,
  "description": "Project-agnostic issue and retrospective loop skill",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:e2e:console": "playwright test -c tests/console/playwright.config.mjs",
    "test:e2e:orca": "node adapters/orca/e2e.mjs",
    "test:skill": "node --test scripts/self-loop.test.mjs",
    "test:server": "node --test server/server.test.mjs",
    "test:e2e:codex": "node scripts/e2e-executor.mjs --adapter codex",
    "test:github:live": "node scripts/github-live-check.mjs",
    "serve": "node server/index.mjs",
    "serve:project": "node server/index.mjs --repo",
    "serve:hosted": "node server/hosted-index.mjs",
    "rotate-token": "node server/index.mjs --rotate-token",
    "setup": "node scripts/setup-project.mjs",
    "init-memory": "node scripts/init-memory.mjs",
    "migrate:sqlite": "node scripts/migrate-store.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/backup.mjs --restore",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1"
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  }
}
